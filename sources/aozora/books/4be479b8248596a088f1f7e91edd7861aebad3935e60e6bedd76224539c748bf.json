ランティアの皆さんです。\r\n\r\n\r\n"},"optimization":{"profile":"pdfreader.lossless-corpus-repack/1","fontSha256":"91704e5dbe15544de864abec3cfaff2e6c365dae4b15b96726622f032020e4e0","sourceBookSha256":"5d68349744304d4708440787fff6a5ffa23ac07ae9359ef9512560e02f11168b"}}