ww.aozora.gr.jp/）で作られました。入力、校正、制作にあたったのは、ボランティアの皆さんです。\r\n\r\n\r\n"},"optimization":{"profile":"pdfreader.lossless-corpus-repack/1","fontSha256":"91704e5dbe15544de864abec3cfaff2e6c365dae4b15b96726622f032020e4e0","sourceBookSha256":"2b721ff6031424c8c4e1526ad51fd0a91274d8f917f78850d54826e08851ec10"}}