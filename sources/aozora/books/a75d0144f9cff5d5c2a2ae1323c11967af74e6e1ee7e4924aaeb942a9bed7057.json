dfreader.lossless-corpus-repack/1","fontSha256":"91704e5dbe15544de864abec3cfaff2e6c365dae4b15b96726622f032020e4e0","sourceBookSha256":"8ed607aac92312c6a5b3f4e36776c5ba740b1337cb0286395fa498057cccfef4"}}