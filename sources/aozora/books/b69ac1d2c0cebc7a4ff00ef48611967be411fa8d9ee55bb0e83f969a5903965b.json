で作られました。入力、校正、制作にあたったのは、ボランティアの皆さんです。\r\n\r\n"},"optimization":{"profile":"pdfreader.lossless-corpus-repack/1","fontSha256":"91704e5dbe15544de864abec3cfaff2e6c365dae4b15b96726622f032020e4e0","sourceBookSha256":"313add6e0a96a2638b78a557a1ef8a04432c4794eb934c310ec8206a61cce1e2"}}